{
    "name": "Vitomu",
    "desktopName": "Vitomu",
    "version": "2.1.1",
    "description": "Video to audio converter",
    "homepage": "https://github.com/digimezzo/vitomu",
    "repository": {
        "type": "git",
        "url": "https://github.com/digimezzo/vitomu.git"
    },
    "bugs": {
        "url": "https://github.com/digimezzo/vitomu/issues"
    },
    "author": {
        "name": "Digimezzo",
        "email": "digimezzo@outlook.com",
        "url": "https://github.com/digimezzo/vitomu"
    },
    "keywords": [
        "angular",
        "angular 8",
        "electron",
        "typescript",
        "sass"
    ],
    "main": "main.js",
    "private": true,
    "scripts": {
        "postinstall": "npm run postinstall:electron && electron-builder install-app-deps",
        "postinstall:web": "node postinstall-web",
        "postinstall:electron": "node postinstall",
        "ng": "node --openssl-legacy-provider ./node_modules/@angular/cli/bin/ng",
        "start": "npm run postinstall:electron && npm-run-all -p ng:serve electron:serve",
        "build": "npm run postinstall:electron && npm run electron:serve-tsc && npm run ng -- build",
        "build:dev": "npm run build -- -c dev",
        "build:prod": "npm run build -- -c production",
        "ng:serve": "npm run ng -- serve",
        "ng:serve:web": "npm run postinstall:web && npm run ng -- serve -o",
        "electron:serve-tsc": "tsc -p tsconfig-serve.json",
        "electron:serve": "wait-on http-get://localhost:4200/ && npm run electron:serve-tsc && electron . --serve",
        "electron:local": "npm run build:prod && electron .",
        "electron:linux": "npm run build:prod && electron-builder build --linux --config electron-builder.config.js && bash scripts/repackage-appimage-fuse3.sh release x86_64",
        "electron:windows": "npm run build:prod && electron-builder build --windows --config electron-builder.config.js",
        "electron:mac": "npm run build:prod && electron-builder build --mac --config electron-builder.config.js",
        "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
        "test": "npx jest --verbose --noStackTrace",
        "test-block": "npx jest --verbose -t",
        "test-file": "npx jest --verbose -i"
    },
    "devDependencies": {
        "@angular-builders/custom-webpack": "^16.0.1",
        "@angular-devkit/build-angular": "16.2.16",
        "@angular/cli": "16.2.16",
        "@angular/common": "16.2.12",
        "@angular/compiler": "16.2.12",
        "@angular/compiler-cli": "16.2.12",
        "@angular/core": "16.2.12",
        "@angular/forms": "16.2.12",
        "@angular/platform-browser": "16.2.12",
        "@angular/platform-browser-dynamic": "16.2.12",
        "@angular/router": "16.2.12",
        "@ngx-translate/core": "^15.0.0",
        "@ngx-translate/http-loader": "^8.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^14.14.33",
        "ajv": "^8.20.0",
        "conventional-changelog-cli": "2.0.11",
        "electron": "^38.0.0",
        "electron-builder": "26.15.7",
        "electron-reload": "1.5.0",
        "jest": "^29.7.0",
        "jest-preset-angular": "^13.1.6",
        "npm-run-all": "4.1.5",
        "rxjs": "6.6.7",
        "ts-jest": "^29.4.12",
        "typemoq": "^2.1.0",
        "typescript": "4.9.5",
        "wait-on": "7.2.0",
        "zone.js": "0.13.3"
    },
    "engines": {
        "node": ">=10.9.0"
    },
    "dependencies": {
        "@angular/animations": "^16.2.12",
        "@angular/cdk": "^16.2.14",
        "@angular/material": "^16.2.14",
        "@electron/remote": "^2.1.3",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "command-exists-promise": "^2.0.2",
        "electron-log": "4.4.8",
        "electron-window-state": "^5.0.3",
        "ffbinaries": "^1.1.4",
        "fs-extra": "11.1.1",
        "line-awesome": "^1.3.0",
        "node-downloader-helper": "^1.0.19",
        "tinycolor2": "1.6.0"
    }
}
